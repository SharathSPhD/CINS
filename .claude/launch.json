{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cins-backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "app/backend", "--port", "8000", "--workers", "1"],
      "port": 8000
    },
    {
      "name": "cins-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app/frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
