# Build context is the repo root (see app/backend/Dockerfile). Keep the
# context small — this repo has large experiment artifacts and two full
# node_modules/venv trees that must never end up in an image layer.
.git
.venv
.claude
node_modules
app/frontend/node_modules
app/frontend/.next
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
experiments/results
# ...but re-include the archived showcase evidence (Dockerfile COPYs it for
# /api/showcase + /static; dockerignore is last-match-wins so ! works here)
!experiments/results/t7_naca2412
!experiments/results/t8
docs
paper
site
!site/gates.json
*.md
!README.md
app/backend/.cache
.remember
